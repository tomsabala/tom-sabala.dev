# Environment for the ADMIN FamilyCFO instance (one per whitelisted email).
# Copy to familycfo.admin.env on the VPS.
#
# Unlike the anonymous instances, this one's /data is a NAMED DOCKER VOLUME: its SQLite database and
# the .secret_key beside it — and therefore the stored bank logins — persist on the VPS disk across
# restarts, until `docker volume rm apps-familycfo-<key>` removes them. That is the only eraser.
#
# No TENANT_MODE / GATEWAY_SECRET here: this app reads no identity header. It holds one household
# per database file, so the container is the tenancy boundary.
FEATURE_SCRAPE=1
# Headless instead of headful-under-Xvfb, if a bank's login works that way. Some refuse headless.
# SHOW_BROWSER=0
LOG_LEVEL=warn
