# Environment for an ANONYMOUS FamilyCFO instance — one container per visitor session, all state on
# a tmpfs that is destroyed when the session goes idle. Copy to familycfo.anon.env on the VPS.
#
# HOSTED=1 is baked into the image: it binds 0.0.0.0, replaces the loopback guard with a
# same-origin one, and enables the in-app credential store.
#
# No TENANT_MODE / GATEWAY_SECRET here: this app reads no identity header. It holds one household
# per database file, so the container is the tenancy boundary.
#
# Scraping is ON here, and that is the whole point of this instance: a visitor types their own bank
# login into the app, it is encrypted into that container's own SQLite file under a key file beside
# it, and both are destroyed with the container. There is no operator-owned credential anywhere.
FEATURE_SCRAPE=1
# Headless instead of headful-under-Xvfb, if a bank's login works that way. Some refuse headless.
# SHOW_BROWSER=0
LOG_LEVEL=warn
