# Environment for the SHARED TREK instance — one container serving every visitor.
# TREK has its own accounts, so one container is correct here; visitors are separated
# by TREK's login, not by the broker.
#
# APP_URL is MANDATORY and must carry the mount prefix: getAppUrl() falls back to the
# first ALLOWED_ORIGINS entry, which has no path, and email links, the OIDC redirect_uri
# and OAuth discovery would all silently lose /a/trek.
APP_URL=https://apps.tom-sabala.dev/a/trek
ALLOWED_ORIGINS=https://apps.tom-sabala.dev
# One proxy sets X-Forwarded-*: Caddy. The broker passes headers through untouched.
TRUST_PROXY=1
# Leave FORCE_HTTPS and HSTS_INCLUDE_SUBDOMAINS unset: the gateway terminates TLS and
# owns HSTS for the whole origin.
TZ=UTC
LOG_LEVEL=info
# openssl rand -hex 32 — without it TREK generates one into the volume on first boot.
ENCRYPTION_KEY=
# First boot only, when no users exist. Remove ADMIN_PASSWORD once you have signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
