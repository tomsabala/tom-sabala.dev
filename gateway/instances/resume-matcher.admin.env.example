# Environment for the ADMIN Resume Matcher instance (one per whitelisted email).
# Copy to resume-matcher.admin.env (git-ignored) on the VPS.
#
# This one gets a real key: it is your own instance, on a named volume, behind sign-in.

# MANDATORY since the 2026-09 builds: an empty TENANT_MODE aborts startup. One container
# per admin email, so this instance really is single-user. See the anon file for the
# `header` alternative and gateway/README.md for the tenant contract behind it.
TENANT_MODE=single

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LOG_LEVEL=INFO
