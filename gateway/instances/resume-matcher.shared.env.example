# Environment for a SHARED instance — one container serving every visitor.
#
# Resume-Matcher is multi-tenant in process: every document table carries `workspace_id`,
# identity arrives as X-Apps-Tenant authenticated by GATEWAY_SECRET, and TENANT_MODE is a
# required setting that aborts boot when unset. Shared mode is therefore *supportable*.
# This file is also the template for any other app that can: copy it to <slug>.shared.env.

# An app that takes its tenant from a header needs both of these, and the broker sends the
# secret back as X-Apps-Proxy-Secret so the app can tell this gateway from a client typing
# the header itself. `openssl rand -hex 32`, ASCII only.
#
# `apps.json` nevertheless keeps `"mode": "session"` for Resume-Matcher. One container per
# visitor also contains an app-level authz bug — a single missed `workspace_id` filter would
# be cross-visitor in shared mode and nothing in shared mode — and the app writes its own
# `data/.secret_key` beside the SQLite file that key encrypts, so one container's filesystem
# is one visitor's blast radius.
TENANT_MODE=header
GATEWAY_SECRET=replace-me-openssl-rand-hex-32

LLM_PROVIDER=
LLM_MODEL=
LOG_LEVEL=INFO
