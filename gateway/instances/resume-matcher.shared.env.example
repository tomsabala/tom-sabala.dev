# Environment for a SHARED instance — one container serving every visitor.
#
# Resume-Matcher must NOT run in shared mode: its api_keys, improvements and
# tailoring_previews tables have no owner column, so every visitor would see everyone
# else's resumes and API key. This file exists as the template for apps that *can*:
# copy it to <slug>.shared.env for an app with its own accounts, or one that stores nothing.

LLM_PROVIDER=
LLM_MODEL=
LOG_LEVEL=INFO
