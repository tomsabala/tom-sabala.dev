# Environment for a SHARED instance — one container serving every visitor.
#
# Resume-Matcher must NOT run in shared mode: its api_keys, improvements and
# tailoring_previews tables have no owner column, so every visitor would see everyone
# else's resumes and API key. This file exists as the template for apps that *can*:
# copy it to <slug>.shared.env for an app with its own accounts, or one that stores nothing.

# An app that takes its tenant from a header needs both of these, and the broker sends the
# secret back as X-Apps-Proxy-Secret so the app can tell this gateway from a client typing
# the header itself. `openssl rand -hex 32`, ASCII only.
#
# Whether Resume-Matcher may now run shared is a question about *its* tenancy, not about
# these two lines: the 2026-09 builds scope data per X-Apps-Tenant, but nothing here has
# verified that every table it writes is covered. Until something does, `mode: "session"`
# in apps.json stays the boundary.
TENANT_MODE=header
GATEWAY_SECRET=replace-me-openssl-rand-hex-32

LLM_PROVIDER=
LLM_MODEL=
LOG_LEVEL=INFO
