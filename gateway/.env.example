# Compose environment for the production stack. Copy to gateway/.env on the VPS.
# Everything here is a secret or a deployment detail; .env is git-ignored.

# Public hostname Caddy answers on, and the host in the OAuth redirect URI.
APPS_SITE_ADDRESS=apps.tom-sabala.dev

# The launcher and the bundles are served from disk by Caddy (see launcher-build), so there
# is no upstream to configure. This is only where /index.html and /terminal.html are sent:
# the portfolio entries in the same build belong on the origin that has the admin session.
PORTFOLIO_ORIGIN=https://tom-sabala.dev

# Session signing key for the per-visitor cookie. 32+ chars.
#   openssl rand -base64 48
SESSION_SECRET=

# Existing Google OAuth client (Console → APIs & Services → Credentials → the Web
# application client whose id matches the backend's GOOGLE_CLIENT_ID), with
# https://apps.tom-sabala.dev/oauth2/callback added as an authorised redirect URI.
#
# The portfolio never used this client's secret — it verifies Google ID tokens against the
# client *id* alone (backend/app/services/google_oauth_service.py). oauth2-proxy runs the
# authorisation-code flow, so it needs the secret. Google hashes secrets now and shows them
# only at creation, so an older client's secret is likely unrecoverable: click "Add secret"
# on the client details page. Max two, and adding one does not affect portfolio sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=

# Capacity. The per-kind caps are independent, so MAX_TOTAL_INSTANCES is the one that has to
# match the box: leave it 0 to mean "anon + admin", or set it to what the RAM actually holds.
# Budget per instance = its manifest memoryMb (resume-matcher: 768 MB). The gateway itself
# is ~55 MB, so: usable RAM = total - ~0.6 GB for OS + Docker + gateway.
#   2 GB box → MAX_TOTAL_INSTANCES=1    4 GB → 4    8 GB → 9
# Subtract a slot if you rebuild or pull while the box is serving: launcher-build peaks
# around 1 GB, which on a 4 GB box is the fourth slot already spent. There, set 3.
MAX_ANON_INSTANCES=2
MAX_ADMIN_INSTANCES=2
MAX_TOTAL_INSTANCES=0
# Lower this on a small box: an idle instance holds its slot for this long, and on a
# one-instance box that means everyone else gets a 503 until it is reaped.
IDLE_TTL_SECONDS=1200
READY_TIMEOUT_SECONDS=90
