# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Server
PORT=5000

# CORS - Update to your production domains (include all frontend origins)
CORS_ORIGINS=https://tom-sabala.dev,https://www.tom-sabala.dev,https://terminal.tom-sabala.dev

# Database - Production PostgreSQL (from hosting provider)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SendGrid - Production
SENDGRID_API_KEY=SG.your-production-api-key
SENDGRID_FROM_EMAIL=noreply@tom-sabala.dev
CONTACT_EMAIL=sabala144@gmail.com

# JWT Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_COOKIE_SECURE=True  # MUST be True in production (HTTPS only)
JWT_COOKIE_SAMESITE=None  # Use 'None' for cross-origin (different domains for frontend/backend)

# Google OAuth
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_WHITELIST=sabala144@gmail.com

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf

# Sentry for error monitoring (HIGHLY RECOMMENDED for production)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Anthropic - company category "Suggest with AI" AND the job-search agent.
# Without it that endpoint returns 503 and POST /api/jobs/agent/runs is refused.
ANTHROPIC_API_KEY=sk-ant-your-production-key

# Job-search agent. REDIS_URL must be set on BOTH the web service (which
# enqueues) and the worker service (which consumes); reference the Railway
# Redis plugin from each.
REDIS_URL=redis://default:password@redis-host:6379/0

# Worker service ONLY (leave unset or 'web' on the API service — only the web
# role runs `flask db upgrade`):
SERVICE_ROLE=worker
# Set to false if the build log shows the playwright chromium install failing;
# discovery then uses static fetches only.
BROWSER_FALLBACK_ENABLED=true
# Optional ceilings (defaults in code): AGENT_DISCOVERY_MODEL,
# AGENT_RANKING_MODEL, AGENT_MAX_COMPANIES_PER_RUN, AGENT_MAX_TOKENS_PER_RUN,
# AGENT_RUN_STALE_MINUTES, AGENT_REDISCOVER_AFTER_DAYS

# Generate secure keys using:
# python3 -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32))"
# python3 -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_hex(32))"
